#define COMBO_TERM_FAST 18
#define COMBO_TERM_SLOW 30

#define COMBO_IDLE_FAST 150
#define COMBO_IDLE_SLOW 50

// ESC - L/R
ZMK_COMBO(esc,   &kp ESC,      RM1 RM2,     CLMK QWTY NAV NUMSYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

// CUT, COPY, PASTE - L
ZMK_COMBO(cut,   &kp LC(X),    LB3 LB1,     CLMK QWTY NAV NUMSYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(copy,  &kp LC(INS),  LB3 LB2,     CLMK QWTY NAV NUMSYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)
ZMK_COMBO(paste, &kp LS(INS),  LB2 LB1,     CLMK QWTY NAV NUMSYM, COMBO_TERM_FAST, COMBO_IDLE_FAST)

